# Example build outputs
example/*/project/output/

# Example 08 outputs: a curated evidence subset is tracked explicitly (git add -f)
example/08_des_thiourethane_aa/project/output/
example/08_des_thiourethane_aa/project/output_partial/
example/08_des_thiourethane_aa/project/output_n33/
example/08_des_thiourethane_aa/project/shrink_output/
example/08_des_thiourethane_aa/project/shrink_output_n33/
example/08_des_thiourethane_aa/project/output_des/

# Cells generated by sizing/cell_sizes.py: the generator is the source of
# truth, so neither the makers nor their outputs are tracked. sizing/*.py,
# sizing/README.md and sizing/run_ledger.tsv (the measured cost history) are.
example/08_des_thiourethane_aa/project/maker_size_*.yaml
example/08_des_thiourethane_aa/project/output_size_*/
example/08_des_thiourethane_aa/project/shrink_output_size_*/
example/08_des_thiourethane_aa/sizing/log_*.txt
example/08_des_thiourethane_aa/project/shrink_output_des/
