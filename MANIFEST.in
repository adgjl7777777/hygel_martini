include README.md
include README_detailed_for_llm.md
include START_HERE_ko.md
include CITATION.cff
include LICENSING.md
include pyproject.toml
include docs/VALIDATION_HISTORY_AND_DESIGN_RATIONALE.md
include docs/PARAMETERIZATION_PROTOCOL.md
recursive-include example/07_portable_pegda *.py *.yaml *.md *.itp *.gro *.txt
include docs/EXPLICIT_PLAN_RELIABILITY.md
recursive-include docs/figures *.py *.json *.svg *.pdf *.png

# Local trajectories, external force fields, and bundled third-party tools are
# not package sources.  Pruning them also prevents editable/sdist metadata
# generation from crawling multi-gigabyte research workspaces.
prune example_myrun
prune martini_v2
prune martini_v300
prune tools/PoreBlazer

global-exclude __pycache__
global-exclude *.py[cod]
