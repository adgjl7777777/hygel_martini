; Short NVT recovery used only after a guarded hard-EM shrink step fails.
integrator              = md
dt                      = 0.002
nsteps                  = 50000
continuation            = no
gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstenergy               = 500
nstlog                  = 500
nstxout-compressed      = 500
nstcalcenergy           = 100
constraints             = none
constraint_algorithm    = lincs
lincs_iter              = 1
lincs_order             = 4
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.1
vdwtype                 = cutoff
rvdw                    = 1.1
tcoupl                  = v-rescale
tc-grps                 = System
tau_t                   = 1.0
ref_t                   = 300
pcoupl                  = no
pbc                     = xyz
comm-mode               = Linear
comm-grps               = System
nstcomm                 = 100
