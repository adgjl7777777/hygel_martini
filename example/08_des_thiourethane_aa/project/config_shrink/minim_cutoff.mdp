; EM run at every accepted shrink step of the all-atom thiourethane network.
; periodic-molecules is mandatory: the covalent network threads the periodic
; boundary, and without it mdrun aborts on inconsistent shifts.
integrator         = steep
nsteps             = 5000
emtol              = 1000.0
emstep             = 0.002
coulombtype        = Cut-off
rcoulomb           = 1.5
vdw_type           = cutoff
rvdw               = 1.5
periodic-molecules = yes
